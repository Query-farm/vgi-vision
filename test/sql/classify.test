# name: test/sql/classify.test
# description: Image classification over a committed tiny PNG (top_label, classify, image_classes)
# group: [vgi_vision]

require-env VGI_VISION_WORKER

statement ok
LOAD vgi;

statement ok
ATTACH 'vision' AS vision (TYPE vgi, LOCATION '{VGI_VISION_WORKER}');

# ---- image_classes(): the model's full ImageNet label set ----
# 1000 rows is well over one producer batch, so over the http transport this
# result is paged across continuation tokens. If the scan cursor (ScanState.offset)
# did not survive each continuation boundary, the http leg would loop forever
# (re-emitting from row 0) or truncate -- so this is a live regression test for the
# HTTP-continuation cursor, exercised on every transport.

query I
SELECT count(*) FROM vision.image_classes();
----
1000

# Indices are 0..999, dense -- every row emitted exactly once, no dupes, no gaps.
# (A broken cursor that re-paged from 0 would inflate the count / break DISTINCT.)
query I
SELECT count(DISTINCT idx) = 1000 AND min(idx) = 0 AND max(idx) = 999 AND count(*) = 1000
FROM vision.image_classes();
----
true

# Ordered head well past the first producer batch: idx=500 is reachable only if
# the cursor paged correctly across the http continuation boundary.
query II
SELECT idx, (label IS NOT NULL AND length(label) > 0) FROM vision.image_classes()
ORDER BY idx LIMIT 1 OFFSET 500;
----
500	true

# ---- top_label(image): #1 prediction for the committed sample.png ----

# The prediction is deterministic for this exact fixture + model (MobileNetV2-12).
query I
SELECT vision.top_label(content) FROM read_blob('test/sql/data/sample.png');
----
envelope

# VARCHAR path overload yields the same label.
query I
SELECT vision.top_label('test/sql/data/sample.png');
----
envelope

# top_label is always one of the model's known classes.
query I
SELECT vision.top_label(content) IN (SELECT label FROM vision.image_classes())
FROM read_blob('test/sql/data/sample.png');
----
true

# ---- classify(image): top-k rows, confidences in [0,1] descending ----
# These use the VARCHAR path overload (classify('<path>')), which reads the file;
# a table function argument cannot itself be a (SELECT ...) subquery.

# Default top_k = 5.
query I
SELECT count(*) FROM vision.classify('test/sql/data/sample.png');
----
5

# Explicit top_k.
query I
SELECT count(*) FROM vision.classify('test/sql/data/sample.png', 3);
----
3

# All confidences are probabilities in [0, 1].
query I
SELECT bool_and(confidence >= 0.0 AND confidence <= 1.0)
FROM vision.classify('test/sql/data/sample.png');
----
true

# The head of the ranked list (highest confidence) is the global max -- a
# well-formed ranked list. Row scan order in SQL is not guaranteed, so the
# descending-emission property is asserted in the pytest suite (where emission
# order is observable).
query I
SELECT max(confidence) = (
    SELECT confidence FROM vision.classify('test/sql/data/sample.png')
    ORDER BY confidence DESC LIMIT 1
)
FROM vision.classify('test/sql/data/sample.png');
----
true

# The #1 classify row agrees with top_label, and its confidence clears a threshold.
query I
SELECT label = 'envelope' AND confidence > 0.10
FROM vision.classify('test/sql/data/sample.png')
ORDER BY confidence DESC
LIMIT 1;
----
true

# ---- composed: classify / top_label joined to the image_classes lookup ----
# (the same SQL the composed catalog examples publish; see vgi_vision/_examples.py)

# ImageNet lists 1000 classes but only 998 distinct labels ("crane" and "maillot"
# appear twice), so image_classes must not be declared UNIQUE on label.
query II
SELECT count(*), count(DISTINCT label) FROM vision.main.image_classes;
----
1000	998

# Top-10 predictions joined to the class list recover each label's idx.
query III
SELECT c.idx, p.label, round(p.confidence, 4) AS confidence FROM vision.main.classify('test/sql/data/sample.png', 10) AS p JOIN vision.main.image_classes AS c USING (label) ORDER BY p.confidence DESC LIMIT 3;
----
549	envelope	0.1352
722	ping-pong ball	0.0981
419	Band Aid	0.0729

# Dog-breed roll-up over the full 1000-class distribution (idx 151-268).
query IIT
SELECT count(*) AS n_breeds, round(sum(p.confidence), 4) AS dog_probability, arg_max(p.label, p.confidence) AS likeliest_breed FROM vision.main.classify('test/sql/data/sample.png', 1000) AS p JOIN vision.main.image_classes AS c USING (label) WHERE c.idx BETWEEN 151 AND 268;
----
118	0.024	Sealyham terrier

# top_label over a list of files, looked up in image_classes; a missing file keeps a NULL row.
query TIT
SELECT f.path, c.idx, c.label FROM (VALUES ('test/sql/data/sample.png'), ('test/sql/data/missing.png')) AS f(path) LEFT JOIN vision.main.image_classes AS c ON c.label = vision.main.top_label(f.path) ORDER BY f.path;
----
test/sql/data/missing.png	NULL	NULL
test/sql/data/sample.png	549	envelope

statement ok
DETACH vision;
